#version 450

// Tensor-core prefill attention over a head-major Q4_K KV cache.
// Dispatch [nQ / 16, nHead]; one 128-invocation workgroup (4 subgroups of 32)
// handles 16 consecutive queries of one query head. Same bindings and push
// constants as attention_flash_q4k; requires headDim 256 and nQ % 16 == 0.
// Two passes over the causal key range in 64-key tiles: pass 1 finds each
// query's softmax max m and sum l, pass 2 accumulates O = (exp(S - m) / l) V,
// so the cooperative-matrix accumulators need no per-row rescaling.

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 128) in;

layout(binding = 0) readonly  buffer Q { float q[]; };
layout(binding = 1) readonly  buffer K { uvec4 d[]; } kbuf;
layout(binding = 2) readonly  buffer V { uvec4 d[]; } vbuf;
layout(binding = 3) writeonly buffer O { float o[]; };

layout(push_constant) uniform P {
    uint  headDim;
    uint  nQ;
    uint  nHead;
    uint  nHeadKV;
    uint  nKV;
    uint  capacity;
    uint  qStart;
    float scale;
} p;

#define HD 256u
#define QB 16u
#define KT 64u
#define QS 264u   // fp16 row stride of Qs and Ks (+8 pad)
#define SF 68u    // fp32 row stride of Sf
#define PS 72u    // fp16 row stride of Ps

shared float16_t Qs[QB * QS];
shared float16_t Ks[KT * QS];   // K tile, then V tile
shared float Sf[QB * SF];
shared float16_t Ps[QB * PS];
shared float mrow[QB];
shared float lrow[QB];

#define ACC coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define MATA coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define MATB coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>

uint hb(uvec4 h, uint i) { return (h[i >> 2u] >> ((i & 3u) * 8u)) & 0xFFu; }

void scaleMin(uvec4 h, uint s, out float dl, out float ml) {
    vec2 dm = unpackHalf2x16(h.x);
    uint sc, m;
    if (s < 4u) {
        sc = hb(h, 4u + s) & 63u;
        m = hb(h, 8u + s) & 63u;
    } else {
        sc = (hb(h, 8u + s) & 0xFu) | ((hb(h, s) >> 6u) << 4u);
        m = (hb(h, 8u + s) >> 4u) | ((hb(h, 4u + s) >> 6u) << 4u);
    }
    dl = dm.x * float(sc);
    ml = dm.y * float(m);
}

// Decode the 64-key tile starting at key t0 of KV head kvh into Ks (fp16,
// [key][dim]); keys at or past nKV become zeros. Each invocation decodes two
// (key, 64-dim group) items.
void loadTile(bool isV, uint kvh, uint t0) {
    uint tid = gl_LocalInvocationIndex;
    for (uint it = tid; it < KT * 4u; it += 128u) {
        uint k = it >> 2u;
        uint g = it & 3u;
        uint tok = t0 + k;
        uint row = k * QS + g * 64u;
        if (tok >= p.nKV) {
            for (uint e = 0u; e < 64u; e++) {
                Ks[row + e] = float16_t(0.0);
            }
            continue;
        }
        uint b4 = (kvh * p.capacity + tok) * 9u;
        uvec4 h = isV ? vbuf.d[b4] : kbuf.d[b4];
        uvec4 c0 = isV ? vbuf.d[b4 + 1u + g * 2u] : kbuf.d[b4 + 1u + g * 2u];
        uvec4 c1 = isV ? vbuf.d[b4 + 2u + g * 2u] : kbuf.d[b4 + 2u + g * 2u];
        float dl0, ml0, dl1, ml1;
        scaleMin(h, g * 2u, dl0, ml0);
        scaleMin(h, g * 2u + 1u, dl1, ml1);
        for (uint i = 0u; i < 8u; i++) {
            uint w = (i < 4u) ? c0[i] : c1[i - 4u];
            for (uint bb = 0u; bb < 4u; bb++) {
                uint byte = (w >> (bb * 8u)) & 0xFFu;
                Ks[row + i * 4u + bb] = float16_t(dl0 * float(byte & 0xFu) - ml0);
                Ks[row + 32u + i * 4u + bb] = float16_t(dl1 * float(byte >> 4u) - ml1);
            }
        }
    }
}

// S tile (16 queries x 16 keys) for this subgroup's key slice of the 64-key tile.
void scoreTile(uint sg) {
    ACC s = ACC(0.0);
    for (uint kk = 0u; kk < HD; kk += 16u) {
        MATA a;
        MATB b;
        coopMatLoad(a, Qs, kk, QS, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b, Ks, (sg * 16u) * QS + kk, QS, gl_CooperativeMatrixLayoutColumnMajor);
        s = coopMatMulAdd(a, b, s);
    }
    coopMatStore(s, Sf, sg * 16u, SF, gl_CooperativeMatrixLayoutRowMajor);
}

void main() {
    uint qb = gl_WorkGroupID.x;
    uint h = gl_WorkGroupID.y;
    if (p.headDim != HD || h >= p.nHead) {
        return;
    }
    uint kvh = h / (p.nHead / p.nHeadKV);
    uint tid = gl_LocalInvocationIndex;
    uint sg = gl_SubgroupID;
    uint q0 = qb * QB;
    // Last causal key for this block (positions qStart + q0 .. + 15).
    uint lastKey = min(p.qStart + q0 + QB - 1u, p.nKV - 1u);
    uint keyEnd = lastKey + 1u;

    // Q block, pre-scaled so S is already scale * q.k.
    for (uint e = tid; e < QB * HD; e += 128u) {
        uint r = e / HD;
        uint dd = e - r * HD;
        Qs[r * QS + dd] = float16_t(q[((q0 + r) * p.nHead + h) * HD + dd] * p.scale);
    }
    if (tid < QB) {
        mrow[tid] = -1e30;
        lrow[tid] = 0.0;
    }

    // Pass 1: row max and sum.
    for (uint t0 = 0u; t0 < keyEnd; t0 += KT) {
        barrier();
        loadTile(false, kvh, t0);
        barrier();
        scoreTile(sg);
        barrier();
        if (tid < QB) {
            uint r = tid;
            uint qpos = p.qStart + q0 + r;
            float m = mrow[r];
            float tmax = -1e30;
            for (uint c = 0u; c < KT; c++) {
                uint j = t0 + c;
                if (j <= qpos && j < p.nKV) {
                    tmax = max(tmax, Sf[r * SF + c]);
                }
            }
            float nm = max(m, tmax);
            float l = lrow[r] * exp(m - nm);
            for (uint c = 0u; c < KT; c++) {
                uint j = t0 + c;
                if (j <= qpos && j < p.nKV) {
                    l += exp(Sf[r * SF + c] - nm);
                }
            }
            mrow[r] = nm;
            lrow[r] = l;
        }
    }

    // Pass 2: O = sum_tiles (exp(S - m) / l) V; this subgroup owns dims sg*64 .. +63.
    ACC o0 = ACC(0.0);
    ACC o1 = ACC(0.0);
    ACC o2 = ACC(0.0);
    ACC o3 = ACC(0.0);
    for (uint t0 = 0u; t0 < keyEnd; t0 += KT) {
        barrier();
        loadTile(false, kvh, t0);
        barrier();
        scoreTile(sg);
        barrier();
        for (uint e = tid; e < QB * KT; e += 128u) {
            uint r = e / KT;
            uint c = e - r * KT;
            uint j = t0 + c;
            float pv = 0.0;
            if (j <= p.qStart + q0 + r && j < p.nKV) {
                pv = exp(Sf[r * SF + c] - mrow[r]) / lrow[r];
            }
            Ps[r * PS + c] = float16_t(pv);
        }
        barrier();
        loadTile(true, kvh, t0);
        barrier();
        for (uint kk = 0u; kk < KT; kk += 16u) {
            MATA a;
            coopMatLoad(a, Ps, kk, PS, gl_CooperativeMatrixLayoutRowMajor);
            MATB b0;
            MATB b1;
            MATB b2;
            MATB b3;
            coopMatLoad(b0, Ks, kk * QS + sg * 64u, QS, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(b1, Ks, kk * QS + sg * 64u + 16u, QS, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(b2, Ks, kk * QS + sg * 64u + 32u, QS, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(b3, Ks, kk * QS + sg * 64u + 48u, QS, gl_CooperativeMatrixLayoutRowMajor);
            o0 = coopMatMulAdd(a, b0, o0);
            o1 = coopMatMulAdd(a, b1, o1);
            o2 = coopMatMulAdd(a, b2, o2);
            o3 = coopMatMulAdd(a, b3, o3);
        }
    }
    uint obase = (q0 * p.nHead + h) * HD + sg * 64u;
    uint ostride = p.nHead * HD;
    coopMatStore(o0, o, obase, ostride, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(o1, o, obase + 16u, ostride, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(o2, o, obase + 32u, ostride, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(o3, o, obase + 48u, ostride, gl_CooperativeMatrixLayoutRowMajor);
}
