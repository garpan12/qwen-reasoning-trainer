#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Row-cooperative Q5_K GEMV, coalesced: y[n] = sum_k dequant(W[n,k]) * x[k].
// One 32-lane subgroup per output row (4 rows per 128-invocation workgroup).
// Lanes take consecutive 16-byte chunks of the row's quant data, so each warp
// load is contiguous; the subgroupAdd gives y[n].

layout(local_size_x = 128) in;

layout(binding = 0) readonly  buffer W { uvec4 data[]; };
layout(binding = 1) readonly  buffer X { vec4 x[]; };
layout(binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    uint K;
    uint N;
    uint rowBase;
} p;

// Byte i of a 16-byte block header.
uint hb(uvec4 h, uint i) { return (h[i >> 2u] >> ((i & 3u) * 8u)) & 0xFFu; }

// Scale and min of sub-block s (0..7) from a Q4_K/Q5_K header (d, dmin, 12
// packed 6-bit scales), as in the get_scale_min_k4 layout.
void scaleMin(uvec4 h, uint s, out float dl, out float ml) {
    vec2 dm = unpackHalf2x16(h.x);
    uint sc, m;
    if (s < 4u) {
        sc = hb(h, 4u + s) & 63u;
        m = hb(h, 8u + s) & 63u;
    } else {
        sc = (hb(h, 8u + s) & 0xFu) | ((hb(h, s) >> 6u) << 4u);
        m = (hb(h, 8u + s) >> 4u) | ((hb(h, 4u + s) >> 6u) << 4u);
    }
    dl = dm.x * float(sc);
    ml = dm.y * float(m);
}

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint n = p.rowBase + gl_WorkGroupID.x * 4u + gl_SubgroupID;
    if (n >= p.N) {
        return;
    }
    // Block = 176 bytes = 11 uvec4: header, qh (2 uvec4), then 8 chunks of qs.
    // Chunk c covers bytes j = 16*(c&1)..+15 of group g = c>>1 (as Q4_K); the
    // fifth bits of those bytes are qh bytes j: qh uvec4 1 + (c&1), bit 2g for
    // the low nibble, bit 2g+1 for the high one.
    uint bpr = p.K / 256u;
    uint rowU4 = n * bpr * 11u;
    float acc = 0.0;
    for (uint u = lane; u < bpr * 8u; u += 32u) {
        uint b = u >> 3u;
        uint c = u & 7u;
        uint g = c >> 1u;
        uint bb = rowU4 + b * 11u;
        uvec4 h = data[bb];
        uvec4 qh = data[bb + 1u + (c & 1u)];
        uvec4 q = data[bb + 3u + c];
        float dl0, ml0, dl1, ml1;
        scaleMin(h, g * 2u, dl0, ml0);
        scaleMin(h, g * 2u + 1u, dl1, ml1);
        uint s0 = g * 2u;
        uint s1 = s0 + 1u;
        uint x0 = (b * 256u + g * 64u) / 4u + (c & 1u) * 4u;
        for (uint i = 0u; i < 4u; i++) {
            uint w = q[i];
            uint hw = qh[i];
            vec4 lo = vec4(float((w & 0xFu) | (((hw >> s0) & 1u) << 4u)),
                           float(((w >> 8u) & 0xFu) | (((hw >> (8u + s0)) & 1u) << 4u)),
                           float(((w >> 16u) & 0xFu) | (((hw >> (16u + s0)) & 1u) << 4u)),
                           float(((w >> 24u) & 0xFu) | (((hw >> (24u + s0)) & 1u) << 4u)));
            vec4 hi = vec4(float(((w >> 4u) & 0xFu) | (((hw >> s1) & 1u) << 4u)),
                           float(((w >> 12u) & 0xFu) | (((hw >> (8u + s1)) & 1u) << 4u)),
                           float(((w >> 20u) & 0xFu) | (((hw >> (16u + s1)) & 1u) << 4u)),
                           float((w >> 28u) | (((hw >> (24u + s1)) & 1u) << 4u)));
            acc += dot(dl0 * lo - vec4(ml0), x[x0 + i]);
            acc += dot(dl1 * hi - vec4(ml1), x[x0 + 8u + i]);
        }
    }
    acc = subgroupAdd(acc);
    if (lane == 0u) {
        y[n] = acc;
    }
}
