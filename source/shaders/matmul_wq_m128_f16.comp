#version 450
// 128-token tile variant: each workgroup covers 128 activation columns, so each
// dequantized weight element is reused twice as often as in the 64-token tile.
#define TN 128
#define TNMICRO 8
// Fused f16 dequantize + GEMM (forward). Generated dispatch wrapper; the body
// and decoder live in matmul_wq_body.glsl / quant_decode.glsl.
#define QDECODE(n, kk) deq_f16(n, kk)
#include "matmul_wq_body.glsl"
