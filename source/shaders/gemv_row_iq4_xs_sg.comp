#version 450

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Row-cooperative IQ4_XS GEMV, coalesced: y[n] = sum_k dequant(W[n,k]) * x[k].
// One 32-lane subgroup per output row (4 rows per 128-invocation workgroup).
// Lanes take consecutive 8-byte chunks of the row's quant data, so each warp
// load is contiguous; the subgroupAdd gives y[n].

layout(local_size_x = 128) in;

layout(binding = 0) readonly  buffer W { uvec2 data[]; };
layout(binding = 1) readonly  buffer X { vec4 x[]; };
layout(binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    uint K;
    uint N;
    uint rowBase;
} p;

shared float KV[16];

const float KVALS[16] = float[16](
    -127.0, -104.0, -83.0, -65.0, -49.0, -35.0, -22.0, -10.0,
    1.0, 13.0, 25.0, 38.0, 53.0, 69.0, 89.0, 113.0);

void main() {
    if (gl_LocalInvocationIndex < 16u) {
        KV[gl_LocalInvocationIndex] = KVALS[gl_LocalInvocationIndex];
    }
    barrier();
    uint lane = gl_SubgroupInvocationID;
    uint n = p.rowBase + gl_WorkGroupID.x * 4u + gl_SubgroupID;
    if (n >= p.N) {
        return;
    }
    // Block = 136 bytes = 17 uvec2: header (d, scales_h | scales_l), then 16
    // chunks of qs. Chunk u covers 8 bytes j = 8*(u&1).. of sub-block ib = u>>1
    // (16 bytes, 32 elements); byte j's low nibble is element ib*32 + j, its
    // high nibble element ib*32 + 16 + j.
    uint bpr = p.K / 256u;
    uint rowU2 = n * bpr * 17u;
    float acc = 0.0;
    for (uint u = lane; u < bpr * 16u; u += 32u) {
        uint b = u >> 4u;
        uint cu = u & 15u;
        uint ib = cu >> 1u;
        uvec2 h = data[rowU2 + b * 17u];
        uvec2 q = data[rowU2 + b * 17u + 1u + cu];
        float d = unpackHalf2x16(h.x).x;
        uint shv = h.x >> 16u;
        uint sl = (h.y >> ((ib >> 1u) * 8u)) & 0xFFu;
        int ls = int((sl >> (4u * (ib & 1u))) & 0xFu) | int(((shv >> (2u * ib)) & 3u) << 4u);
        float dl = d * float(ls - 32);
        uint xl = (b * 256u + ib * 32u) / 4u + (cu & 1u) * 2u;
        for (uint i = 0u; i < 2u; i++) {
            uint w = q[i];
            vec4 vlo = vec4(KV[w & 0xFu], KV[(w >> 8u) & 0xFu], KV[(w >> 16u) & 0xFu], KV[(w >> 24u) & 0xFu]);
            vec4 vhi = vec4(KV[(w >> 4u) & 0xFu], KV[(w >> 12u) & 0xFu], KV[(w >> 20u) & 0xFu], KV[w >> 28u]);
            acc += dl * (dot(vlo, x[xl + i]) + dot(vhi, x[xl + 4u + i]));
        }
    }
    acc = subgroupAdd(acc);
    if (lane == 0u) {
        y[n] = acc;
    }
}
