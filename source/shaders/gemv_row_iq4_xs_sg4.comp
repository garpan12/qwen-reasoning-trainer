#version 450
#define NR 4u

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Row-cooperative IQ4_XS GEMV, coalesced: y[n] = sum_k dequant(W[n,k]) * x[k].
// 4 output rows per 32-lane subgroup (16 per 128-invocation workgroup).
// Lanes take consecutive 8-byte chunks of the row's quant data, so each warp
// load is contiguous; the subgroupAdd gives y[n].

layout(local_size_x = 128) in;

layout(binding = 0) readonly  buffer W { uvec2 data[]; };
layout(binding = 1) readonly  buffer X { vec4 x[]; };
layout(binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    uint K;
    uint N;
    uint rowBase;
} p;

shared float KV[16];

const float KVALS[16] = float[16](
    -127.0, -104.0, -83.0, -65.0, -49.0, -35.0, -22.0, -10.0,
    1.0, 13.0, 25.0, 38.0, 53.0, 69.0, 89.0, 113.0);

void main() {
    if (gl_LocalInvocationIndex < 16u) {
        KV[gl_LocalInvocationIndex] = KVALS[gl_LocalInvocationIndex];
    }
    barrier();
    uint lane = gl_SubgroupInvocationID;
    // NR rows per subgroup; x chunks are loaded once for all of them.
    uint n0 = p.rowBase + (gl_WorkGroupID.x * 4u + gl_SubgroupID) * NR;
    if (n0 >= p.N) {
        return;
    }
    uint bpr = p.K / 256u;
    uint rb[NR];
    float acc[NR];
    for (uint r = 0u; r < NR; r++) {
        rb[r] = min(n0 + r, p.N - 1u) * bpr * 17u;
        acc[r] = 0.0;
    }
    for (uint u = lane; u < bpr * 16u; u += 32u) {
        uint b = u >> 4u;
        uint cu = u & 15u;
        uint ib = cu >> 1u;
        uint xl = (b * 256u + ib * 32u) / 4u + (cu & 1u) * 2u;
        vec4 xlo0 = x[xl];
        vec4 xlo1 = x[xl + 1u];
        vec4 xhi0 = x[xl + 4u];
        vec4 xhi1 = x[xl + 5u];
        for (uint r = 0u; r < NR; r++) {
            uvec2 h = data[rb[r] + b * 17u];
            uvec2 q = data[rb[r] + b * 17u + 1u + cu];
            uint w = q.x;
            float s = dot(vec4(KV[w & 0xFu], KV[(w >> 8u) & 0xFu], KV[(w >> 16u) & 0xFu], KV[(w >> 24u) & 0xFu]), xlo0)
                    + dot(vec4(KV[(w >> 4u) & 0xFu], KV[(w >> 12u) & 0xFu], KV[(w >> 20u) & 0xFu], KV[w >> 28u]), xhi0);
            w = q.y;
            s += dot(vec4(KV[w & 0xFu], KV[(w >> 8u) & 0xFu], KV[(w >> 16u) & 0xFu], KV[(w >> 24u) & 0xFu]), xlo1)
               + dot(vec4(KV[(w >> 4u) & 0xFu], KV[(w >> 12u) & 0xFu], KV[(w >> 20u) & 0xFu], KV[w >> 28u]), xhi1);
            float d = unpackHalf2x16(h.x).x;
            uint sl = (h.y >> ((ib >> 1u) * 8u)) & 0xFFu;
            int ls = int((sl >> (4u * (ib & 1u))) & 0xFu) | int((((h.x >> 16u) >> (2u * ib)) & 3u) << 4u);
            acc[r] += d * float(ls - 32) * s;
        }
    }
    for (uint r = 0u; r < NR; r++) {
        float t = subgroupAdd(acc[r]);
        if (lane == 0u && n0 + r < p.N) {
            y[n0 + r] = t;
        }
    }
}
